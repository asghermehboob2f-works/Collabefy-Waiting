# ----------------------------------------------------------------------
# Collabify — Apache / LiteSpeed Web Server Configuration
# Clean URLs (no .php or .html), Security & Performance for Shared Hosting
# ----------------------------------------------------------------------

# 1. Default index document
DirectoryIndex index.php index.html

# 2. Disable directory listing for security
Options -Indexes

# 3. URL Rewriting & Clean URLs
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Prevent loop for existing directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Redirect /index.php or /index.html to root / (301 Permanent Redirect)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.(php|html)\ HTTP/
    RewriteRule ^index\.(php|html)$ / [R=301,L]

    # Redirect external .php requests to extensionless URL (e.g. /page.php -> /page)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.php(\?[^\ ]*)?\ HTTP/
    RewriteRule ^([^\.]+)\.php$ /$1 [R=301,L]

    # Redirect external .html requests to extensionless URL (e.g. /page.html -> /page)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\ ]+)\.html(\?[^\ ]*)?\ HTTP/
    RewriteRule ^([^\.]+)\.html$ /$1 [R=301,L]

    # Internally resolve extensionless URL to .php if file exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]

    # Internally resolve extensionless URL to .html if file exists
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# 4. Protect sensitive files and subscriber data
<FilesMatch "(^\.|\.csv$|\.json$|\.txt$|\.log$|\.sql$|\.env$|\.bak$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# 6. Enable GZIP / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 7. Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
